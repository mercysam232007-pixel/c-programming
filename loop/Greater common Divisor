#include <stdio.h>

int main() {
    int a, b, i, gcd;

    printf("Enter two numbers: ");
    scanf("%d %d", &a, &b);

    // loop from 1 to smallest number
    for (i = 1; i <= a && i <= b; i++) {
        if (a % i == 0 && b % i == 0) {
            gcd = i;   // store common divisor
        }
    }

    printf("GCD = %d", gcd);

    return 0;
}
