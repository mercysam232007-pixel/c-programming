#include<stdio.h>
int main() {
    int i,n,rem,sum=0;
    printf("Enter a number: ");
    scanf("%d",&n);
    for(i=1;i<n;i++) {
        rem=n%i;
        if (rem==0)
            sum=sum+i;
    }
    if (sum==n)
        printf("It is a perfect number");
    else
        printf("It is not a perfect number");
}
