#include<stdio.h>
int main() {
    int i,j,n;
    scanf("%d",&n);
    for (i=1;i<=n;i++) {                //row
        for (j=1;j<=2*i-1;j++) {        //2*i-1=star
            printf("*");
        }
        printf("\n");
    }
    for (i=n-1;i>=1;i--) {                //inverting pyramid            row
        for (j=1;j<=2*i-1;j++) {          //star
            printf("*");
        }
        printf("\n");
    }
}
