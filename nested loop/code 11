#include<stdio.h>
int main() {
    int i, j, n, num;
    scanf("%d", &n);
    for(i = 1; i <= n; i++) {
        if(i % 2 == 1)
            num = 1;
        else
            num = 0;
        for(j = 1; j <= i; j++) {
            printf("%d", num);
            num = 1 - num;   // toggle between 1 and 0
        }
        printf("\n");
    }

    return 0;
}
