#include <stdio.h>
#include <math.h>

int main() {
    long int binary;
    int decimal = 0, i = 0, rem;

    printf("Enter a binary number: ");
    scanf("%ld", &binary);

    for(i = 0; binary != 0; i++) {
        rem = binary % 10;          // Get last digit
        decimal = decimal + rem * pow(2, i);
        binary = binary / 10;       // Remove last digit
    }

    printf("Decimal value = %d", decimal);

    return 0;
}
