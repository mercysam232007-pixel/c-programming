#include<stdio.h>
int main() {
    int type,age;
    printf("Enter your type: ");
    scanf("%d",&type);
    printf("Enter age: ");
    scanf("%d",&age);

    switch(type) {
        case 1:
            if (age<=5)
                printf("1500");
            else
                printf("2500");
            break;
        case 2:
            if (age<=5)
                printf("5000");
            else
                printf("6000");

    }
}
