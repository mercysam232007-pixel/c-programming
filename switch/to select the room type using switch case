#include<stdio.h>
int main() {
    int room;
    char season;
    printf("Enter the room type:");
    scanf("%d",&room);
    printf("Enter the season: ");
    scanf(" %c",&season);

    switch (room) {
        case 1://standard
            if (season=='A')
                printf("2500");
            else if (season=='B')
                printf("2000");
            break;
        case 2://Deluxe
            if (season=='C')
                printf("4000");
            else if(season=='D')
                printf("3000");
            break;
        default:
            printf("Invalid room type");
    }
    return 0;
}
